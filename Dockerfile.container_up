ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/app
COPY requirements-backend.lock /opt/build/requirements.lock
COPY vendor/wheels /opt/build/wheels
RUN pip install --no-index --find-links=/opt/build/wheels --require-hashes -r /opt/build/requirements.lock \
    && rm -rf /opt/build
COPY agent_backend /opt/app/agent_backend
COPY container_up /opt/app/container_up
RUN useradd --uid 10001 --create-home agent && mkdir /data && chown agent:agent /data
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "agent_backend", "control", "--config", "/etc/agent/container-up.yaml"]
