{
  "provider": {
    "intranet": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Internal model endpoint",
      "options": {
        "baseURL": "http://model-service:8000/v1",
        "apiKey": "REPLACE_WITH_THIS_FRONTEND_MODEL_API_KEY"
      },
      "models": {
        "your-model": {
          "name": "Internal model",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/mnt/common/web-yk/app/templates/AGENTS.md"
  ],
  "permission": {
    "*": "allow"
  },
  "autoupdate": false,
  "share": "manual",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {},
  "lsp": {},
  "formatter": {},
  "skills": {
    "paths": [
      "/mnt/common/{frontend_id}/app/skills",
      "/mnt/source/public/skills"
    ]
  }
}
