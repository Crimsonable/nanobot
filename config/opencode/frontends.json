{
  "control": {
    "bucket_pool": {
      "image": "agent-bucket-runtime:opencode-1.18.31",
      "max_users_per_bucket": 16
    }
  },
  "frontends": [
    {
      "id": "web-yk",
      "provider": "web",
      "send_msg_url": "http://your-frontend:8090/outbound",
      "attachment_storage": {
        "provider": "minio",
        "endpoint": "http://minio.minio.svc.cluster.local:9000",
        "access_key": "REPLACE_WITH_MINIO_ACCESS_KEY",
        "secret_key": "REPLACE_WITH_MINIO_SECRET_KEY",
        "bucket": "attachments",
        "public_base_url": "http://your-minio:9000/attachments",
        "key_prefix": "web-outbound",
        "presign_expiry_seconds": 3600
      },
      "instance_idle_ttl_seconds": 3600,
      "runtime": {
        "profiles": {
          "reports": {
            "model": "intranet/your-model",
            "instructions": "Read the relevant SKILL.md in the public directories before generating reports. Save generated files in output and publish them with publish_attachment."
          }
        }
      }
    }
  ]
}
