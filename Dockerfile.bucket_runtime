# Build/export on a connected host; deployment runs without public network access.
ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/app
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap ca-certificates fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-backend.lock /opt/build/requirements.lock
COPY requirements-toolchain.lock /opt/build/toolchain.lock
COPY vendor/wheels /opt/build/wheels
RUN pip install --no-index --find-links=/opt/build/wheels --require-hashes -r /opt/build/requirements.lock \
    && pip install --no-index --find-links=/opt/build/wheels --require-hashes -r /opt/build/toolchain.lock \
    && rm -rf /opt/build
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/toolchain/browsers
RUN python -m playwright install --with-deps chromium
COPY vendor/opencode /opt/opencode/opencode
COPY vendor/opencode.sha256 /opt/opencode/opencode.sha256
RUN cd /opt/opencode && sha256sum -c opencode.sha256 && chmod 0555 opencode
COPY vendor/plugin /opt/opencode-plugin
COPY agent_backend /opt/app/agent_backend
COPY bucket_runtime /opt/app/bucket_runtime
COPY public /opt/public
RUN mkdir -p /opt/runtime-context /opt/public /data /run/secrets \
    && useradd --uid 10001 --create-home agent && chown agent:agent /data
USER 10001:10001
EXPOSE 8090
CMD ["python", "-m", "agent_backend", "runtime", "--config", "/etc/agent/bucket-runtime.yaml"]
