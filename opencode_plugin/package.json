{
  "name": "bucket-runtime-opencode-plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild index.ts permissions.ts --bundle --platform=node --format=esm --outdir=dist --out-extension:.js=.mjs",
    "test": "node --test test.mjs",
    "typecheck": "tsc --noEmit --module nodenext --moduleResolution nodenext --target es2023 --skipLibCheck index.ts permissions.ts"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.2",
    "@opencode/schema": "2.3.2",
    "@types/node": "^24",
    "effect": "4.1.0",
    "esbuild": "0.25.12",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./server": "./dist/index.mjs"
  }
}
